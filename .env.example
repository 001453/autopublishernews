# Tarayıcı profili (çerez / oturum burada saklanır)
# X_PROFILE_DIR=C:\yol\x_profile

# 1 = görünmez tarayıcı (X sık engeller; mümkünse 0 bırakın)
# HEADLESS=0

# X girişi / gönderim tarayıcısı: chrome (varsayılan), msedge, chromium
# BROWSER_CHANNEL=chrome

# 0 = Bot Chrome x_profile (önerilen) — önce: scripts\start_bot_chrome.ps1
# 1 = Masaüstü Chrome + CDP: scripts\chrome_debug.ps1
USE_EXISTING_CHROME=0
# Bot tek pencere CDP (varsayılan 9333; start_bot_chrome.ps1 ile açılır)
# BOT_CDP_PORT=9333
# BOT_CDP_URL=http://127.0.0.1:9333
# CHROME_CDP_URL=http://127.0.0.1:9222

# Döngü aralığı (dk): RSS listesi + kuyruğa yeni haber ekleme
POLL_INTERVAL_MINUTES=15

# Kuyruktan sırayla yayın (dk); tanımlıysa paneldeki yayın aralığını geçersiz kılar
# PUBLISH_INTERVAL_MINUTES=15

# İsteğe bağlı: tek cümle özet kalitesi için OpenAI (ücretli)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# X giriş: scripts\start_bot_chrome.ps1 → panel Chrome oturumu (X) veya python bot.py --login

# Sunucu / Docker (DEPLOY.md)
# DATA_DIR=/app/data
# AUTO_START_SCHEDULER=1
# PANEL_HOST=0.0.0.0
# PANEL_PORT=8765

# Discord webhook (paneldeki URL boşsa yedek olarak kullanılır)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
