# Kopyalayin: copy .env.example .env  — OPENAI_API_KEY tek satir zorunlu.

OPENAI_API_KEY=sk-proj-BURAYA_TEK_SATIR_ANAHTAR
OPENAI_MODEL=gpt-4o-mini
OPENAI_COOLDOWN_SECONDS=300
RSS_PREVIEW_AI_MAX=1

AUTO_START_SCHEDULER=1
POLL_INTERVAL_MINUTES=30
PUBLISH_INTERVAL_MINUTES=120

USE_EXISTING_CHROME=0
BOT_CDP_PORT=9333
BOT_CDP_TIMEOUT_MS=90000
BOT_MAX_CHROME_TABS=2
HEADLESS=0
BROWSER_CHANNEL=chrome

# Opsiyonel (C surucu doluysa D uzerinde veri):
# DATA_DIR=D:\autopublishernews\data
# X_PROFILE_DIR=D:\autopublishernews\x_profile

# DISCORD_WEBHOOK_URL=
