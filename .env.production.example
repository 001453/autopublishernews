# Sunucu / Docker — .env olarak kopyalayin (Git'e EKLEMEYIN)

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

USE_EXISTING_CHROME=0
BROWSER_CHANNEL=chromium
HEADLESS=0

POLL_INTERVAL_MINUTES=30
PUBLISH_INTERVAL_MINUTES=15

DATA_DIR=/app/data
X_PROFILE_DIR=/app/data/x_profile
PANEL_CONFIG_PATH=/app/data/panel_config.json

AUTO_START_SCHEDULER=1
PANEL_HOST=0.0.0.0
PANEL_PORT=8765
BOT_CDP_PORT=9333
